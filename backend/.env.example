# Copy this file to .env and fill in your values.
# For production (e.g. Render): set these in your service's Environment tab.

# MongoDB (required) — use either MONGO_URI or MONGODB_URI
# Atlas → your cluster → Connect → Drivers → Node.js
# Include a database name in the path (e.g. /govpro)

# Option A: SRV connection string (default in Atlas)
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/govpro?retryWrites=true&w=majority&appName=Cluster0


# Option B: Standard connection string — use if you see "querySrv ECONNREFUSED"
# (bypasses SRV DNS lookup; copy the full string from Atlas, including replicaSet)
# MONGO_URI=mongodb://USER:PASSWORD@ac-nu8iiyw-shard-00-00.qgmfshp.mongodb.net:27017,ac-nu8iiyw-shard-00-01.qgmfshp.mongodb.net:27017,ac-nu8iiyw-shard-00-02.qgmfshp.mongodb.net:27017/govpro?ssl=true&authSource=admin&replicaSet=atlas-ro9eym-shard-0&retryWrites=true&w=majority

# Secret used to sign and verify JWT tokens (required for login + commenting)
JWT_SECRET=your-long-random-secret-at-least-32-chars

# Optional: if SRV still fails on Windows, try before starting the server:
# set NODE_OPTIONS=--dns-result-order=ipv4first
